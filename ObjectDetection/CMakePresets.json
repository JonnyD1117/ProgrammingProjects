{
    "version": 4,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 28,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "default",
        "displayName": "Default ",
        "description": "Default settings for both Debug & Release",
        "generator": "Ninja",
        "hidden": true,
        "binaryDir": "${sourceDir}/build",
        "cacheVariables": {
          "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin",
          "CMAKE_CXX_COMPILER": "clang++",
          "CMAKE_CXX_STANDARD": "23",
          "CMAKE_CXX_STANDARD_REQUIRED": "ON",
          "CMAKE_EXPORT_COMPILE_COMMANDS" : "ON",
          "CMAKE_CXX_FLAGS": "-fdiagnostics-color=always"
        },
        "environment": {
          "GTEST_COLOR": "1"
        }
      },
      {
        "name": "release",
        "inherits": "default",
        "displayName": "Release",
        "description": "Use Conan toolchain and Release build type",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/conan/build/Release/generators/conan_toolchain.cmake",
          "CMAKE_BUILD_TYPE": "Release"
        }
      },
      {
        "name": "debug",
        "inherits": "default",
        "displayName": "Debug",
        "description": "Use Conan toolchain and Debug build type",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/conan/build/Debug/generators/conan_toolchain.cmake",
          "CMAKE_BUILD_TYPE": "Debug",
          "CMAKE_CXX_FLAGS": "-fdiagnostics-color=always -fsanitize=address -fno-omit-frame-pointer",
          "CMAKE_EXPORT_COMPILE_COMMANDS":"ON"

        }
      },
      {
        "name": "debug-valgrind",
        "inherits": "default",
        "displayName": "Debug_Valgrind",
        "description": "Use Conan toolchain and Debug build type w/ Valgrind",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/conan/build/Debug/generators/conan_toolchain.cmake",
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "clang-analyzer",
        "displayName": "Clang Static Analyzer",
        "description": "Build using Clang Static Analyzer",
        "generator": "Ninja",
        "inherits": "debug-valgrind",
        "binaryDir": "${sourceDir}/build/static-analyzer",
        "cacheVariables": {
          "CMAKE_CXX_COMPILER": "clang++",
          "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wshadow -Wnull-dereference"
        },
        "environment": {
          "CC": "clang",
          "CXX": "clang++"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "release",
        "configurePreset": "release"
      },
      {
        "name": "debug",
        "configurePreset": "debug"
      },
      {
        "name": "debug-valgrind",
        "configurePreset": "debug-valgrind"
      }
    ],
    "testPresets": [
    {
      "name": "normal-tests",
      "configurePreset": "debug",
      "description": "Run all unit tests with verbose output"
    }
  ]
  }
  